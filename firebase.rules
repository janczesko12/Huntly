rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function roomPath(roomId) {
      return /databases/$(database)/documents/rooms/$(roomId);
    }

    function playerPath(roomId, playerId) {
      return /databases/$(database)/documents/rooms/$(roomId)/players/$(playerId);
    }

    function isHost(roomId) {
      return signedIn() && get(roomPath(roomId)).data.hostUid == request.auth.uid;
    }

    function isMember(roomId) {
      return signedIn() && exists(playerPath(roomId, request.auth.uid));
    }

    function validCoordinates(data) {
      return data.lat is number && data.lat >= -90 && data.lat <= 90
        && data.lng is number && data.lng >= -180 && data.lng <= 180
        && (data.accuracy is number && data.accuracy >= 0 && data.accuracy <= 1000);
    }

    function freshAccuratePosition(data) {
      return validCoordinates(data)
        && data.accuracy <= 10
        && data.locationUpdatedAt is timestamp
        && data.locationUpdatedAt <= request.time
        && data.locationUpdatedAt >= request.time - duration.value(15, 's');
    }

    function capturePositionsValid(roomId, seekerUid, runnerUid) {
      let room = get(roomPath(roomId)).data;
      let seeker = get(playerPath(roomId, seekerUid)).data;
      let runner = get(playerPath(roomId, runnerUid)).data;
      return room.status == 'running'
        && seekerUid != runnerUid
        && seeker.role == 'seeker' && seeker.alive != false
        && runner.role == 'runner' && runner.alive != false
        && freshAccuratePosition(seeker)
        && freshAccuratePosition(runner)
        // Conservative 3.1e-5 degree bound on each axis: under 5m combined,
        // even near the equator. The real GPS distance is also checked in the client.
        && math.abs(seeker.lat - runner.lat) <= 0.000031
        && math.abs(seeker.lng - runner.lng) <= 0.000031;
    }

    function captureHoldValid(roomId, seekerUid, runnerUid) {
      let holdPath = /databases/$(database)/documents/rooms/$(roomId)/captureHolds/$(seekerUid + '_' + runnerUid);
      let hold = get(holdPath).data;
      return exists(holdPath)
        && hold.seekerUid == seekerUid
        && hold.runnerUid == runnerUid
        && hold.startedAt is timestamp
        && hold.startedAt <= request.time - duration.value(2, 's')
        && hold.startedAt >= request.time - duration.value(10, 's');
    }

    match /rooms/{roomId} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.code == roomId
        && request.resource.data.status == 'lobby';
      allow update: if isHost(roomId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'hostUid', 'status', 'escapeSeconds', 'roundMinutes',
          'startedAtMs', 'escapeEndsAtMs', 'roundEndsAtMs',
          'revealEverySeconds', 'revealDurationSeconds', 'areaRadiusMeters',
          'areaCenterLat', 'areaCenterLng', 'seekerCount',
          'zoneShrinkEnabled', 'zoneFinalRadiusMeters',
          'zoneShrinkStartAtMs', 'zoneShrinkDurationSeconds',
          'endedAt', 'updatedAt'
        ])
        && request.resource.data.status in ['lobby', 'escape', 'running', 'ended']
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['hostUid'])
          || exists(playerPath(roomId, request.resource.data.hostUid)));
      allow delete: if false;

      match /players/{playerId} {
        allow get, list: if signedIn() && (playerId == request.auth.uid || isMember(roomId));

        allow create: if signedIn()
          && get(roomPath(roomId)).data.status == 'lobby'
          && playerId == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.role == (get(roomPath(roomId)).data.hostUid == request.auth.uid ? 'seeker' : 'runner')
          && request.resource.data.alive == true
          && request.resource.data.keys().hasOnly([
            'uid', 'name', 'role', 'alive', 'lat', 'lng', 'accuracy',
            'joinedAt', 'locationUpdatedAt', 'onlineAt'
          ])
          && validCoordinates(request.resource.data)
          && request.resource.data.locationUpdatedAt == request.time
          && request.resource.data.onlineAt == request.time;

        allow update: if signedIn() && (
          (
            playerId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'lat', 'lng', 'accuracy', 'outsideArea', 'locationUpdatedAt', 'onlineAt'
            ])
            && validCoordinates(request.resource.data)
            && request.resource.data.locationUpdatedAt == request.time
            && request.resource.data.onlineAt == request.time
          )
          ||
          (
            isHost(roomId)
            && get(roomPath(roomId)).data.status in ['lobby', 'escape']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'alive'])
            && request.resource.data.role in ['seeker', 'runner']
            && request.resource.data.alive == true
          )
          ||
          (
            playerId != request.auth.uid
            && get(roomPath(roomId)).data.status == 'running'
            && get(playerPath(roomId, request.auth.uid)).data.role == 'seeker'
            && resource.data.role == 'runner'
            && resource.data.alive != false
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'role', 'alive', 'caught', 'caughtBy', 'caughtAt', 'joinedSeekerTeamAt'
            ])
            && request.resource.data.role == 'seeker'
            && request.resource.data.alive == true
            && request.resource.data.caught == true
            && request.resource.data.caughtBy == request.auth.uid
            && request.resource.data.caughtAt == request.time
            && request.resource.data.joinedSeekerTeamAt == request.time
            && capturePositionsValid(roomId, request.auth.uid, playerId)
            && captureHoldValid(roomId, request.auth.uid, playerId)
          )
        );

        allow delete: if signedIn() && playerId == request.auth.uid;
      }

      match /captureHolds/{holdId} {
        // Missing reads are allowed so a seeker can check whether a hold exists.
        allow get: if signedIn() && (resource == null || resource.data.seekerUid == request.auth.uid);
        allow list: if false;
        allow create: if signedIn()
          && resource == null
          && holdId == request.auth.uid + '_' + request.resource.data.runnerUid
          && request.resource.data.keys().hasOnly(['seekerUid', 'runnerUid', 'nonce', 'startedAt'])
          && request.resource.data.seekerUid == request.auth.uid
          && request.resource.data.runnerUid is string
          && request.resource.data.runnerUid != request.auth.uid
          && request.resource.data.nonce is string
          && request.resource.data.nonce.size() >= 32
          && request.resource.data.nonce.size() <= 36
          && request.resource.data.startedAt == request.time
          && capturePositionsValid(roomId, request.auth.uid, request.resource.data.runnerUid);
        allow update: if false;
        allow delete: if signedIn() && resource.data.seekerUid == request.auth.uid;
      }
    }
  }
}
